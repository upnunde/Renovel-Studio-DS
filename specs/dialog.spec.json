{
  "$schema": "./README.md",
  "name": "Dialog",
  "slot": "dialog",
  "$description": "OS-중립 Dialog 정본. 출처: src/components/ui/dialog.tsx. overlay+content+header/footer. cva 없음(구조 props).",
  "role": "dialog",
  "$use": ["_shared.floatingSurface", "_shared.disabledPresets"],
  "parts": {
    "overlay": { "rest": { "bg": "{black}/10", "$note": "backdrop-blur-xs(지원 시)" }, "animation": "$use _shared.floatingSurface.animation" },
    "content": {
      "rest": { "bg": "{popover}", "fg": "{popover-foreground}", "ring": "{foreground}/10", "radius": "20", "padding": "{space.5}", "gap": "{space.4}" },
      "maxWidth": { "mobile": "calc(100%-32px)", "desktop": 440 },
      "position": "center (top/left 50% + translate -50%)",
      "animation": "$use _shared.floatingSurface.animation"
    },
    "header": { "gap": "{space.2}", "align": "center", "textAlign": "center" },
    "footer": { "gap": "{space.2}", "$note": "-mx-5 -mb-5 풀블리드, p-5. sm:가로정렬 우측. 음수마진 iOS/AOS는 §2-5-1a 레시피" },
    "title": { "typography": "heading4-700", "textAlign": "center" },
    "description": { "fg": "{foreground-muted}", "textAlign": "center" },
    "closeButton": { "$note": "Button ghost icon-sm(32px), 우상단, close 아이콘 16px(md)" }
  },
  "states": ["open", "closed"],
  "portal": true,
  "nativeNotes": {
    "portal": "overlay+popup 포털. iOS .sheet/.fullScreenCover, Compose Dialog.",
    "z": "overlay=z-overlay(300), content=z-modal(400). 토스트(z-toast 500)만 위.",
    "centering": "웹 transform 센터링. 네이티브는 프레젠테이션 기본 중앙/시트.",
    "a11y": "aria-labelledby/describedby 자동. iOS/AOS 접근성 제목·설명 연결."
  }
}

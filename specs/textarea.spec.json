{
  "$schema": "./README.md",
  "name": "Textarea",
  "slot": "textarea",
  "$description": "OS-중립 Textarea 정본. 출처: src/components/ui/textarea.tsx. size 축 없음(단일).",
  "role": "textbox",
  "axes": {},
  "defaults": {},
  "sizeSpec": {
    "default": { "minHeight": 64, "padX": 10, "padY": 8, "radius": "{radius.base}", "typography": "body3-400", "$note": "rows 지정 시 minHeight=rows*lineHeight. 모바일 text-base→md:text-sm 반응형" }
  },
  "styleSpec": {
    "control": {
      "rest": { "bg": "transparent", "border": "{input}", "fg": "{foreground}", "dark": { "bg": "{input}/30" } },
      "placeholder": { "fg": "{foreground-placeholder}" },
      "focus": { "border": "{ring}", "ring": "{ring}/50", "ringWidth": 3 },
      "disabled": { "bg": "{disabled}", "fg": "{disabled-foreground}", "border": "{disabled-border}", "$ref": "shared.disabledField" },
      "invalid": { "border": "{destructive}", "ring": "{destructive}/20", "dark": { "border": "{destructive}/50", "ring": "{destructive}/40" } }
    }
  },
  "states": ["rest", "focus", "disabled", "invalid"],
  "nativeNotes": {
    "autoGrow": "웹 field-sizing-content(내용따라 자동 성장). iOS UITextView 동적 높이, Compose 자동 높이 처리 필요.",
    "placeholder": "웹 ::placeholder → 플랫폼 placeholder API."
  }
}

{
  "$schema": "./README.md",
  "name": "Toggle",
  "slot": "toggle",
  "$description": "OS-중립 Toggle 정본. 출처: src/components/ui/toggle.tsx. aria-pressed=선택. variant×tone×size.",
  "role": "button",
  "axes": {
    "variant": { "values": ["default", "outline"], "$description": "표현 방식" },
    "tone": { "values": ["neutral", "brand"], "$description": "선택 색. 툴바는 neutral, 브랜드 강조는 brand" },
    "size": { "values": ["sm", "default", "xl", "2xl"] }
  },
  "defaults": { "variant": "default", "tone": "neutral", "size": "default" },
  "sizeSpec": {
    "sm":      { "height": 32, "minW": 32, "padX": 10, "gap": 4, "fontSize": 12.8, "iconGlyph": 14, "radius": "12" },
    "default": { "height": 36, "minW": 36, "padX": 10, "gap": 4, "fontSize": 14, "iconGlyph": 16 },
    "xl":      { "height": 40, "minW": 40, "padX": 12, "gap": 4, "fontSize": 14, "iconGlyph": 16 },
    "2xl":     { "height": 48, "minW": 48, "padX": 12, "gap": 4, "fontSize": 16, "iconGlyph": 16 }
  },
  "base": { "fontWeight": 500, "focus": { "border": "{ring}", "ring": "{ring}/50", "ringWidth": 3 }, "invalid": { "border": "{destructive}", "ring": "{destructive}/20", "dark": { "ring": "{destructive}/40" } } },
  "styleSpec": {
    "default": { "rest": { "bg": "transparent" }, "hover": { "bg": "{muted}", "fg": "{foreground}" } },
    "outline": { "rest": { "bg": "transparent", "border": "{border-emphasis}" }, "hover": { "bg": "{muted}", "fg": "{foreground}" } },
    "tone/neutral": { "pressed": { "bg": "{muted-strong}", "fg": "{muted-strong-foreground}" }, "pressedHover": { "bg": "{muted-strong}" } },
    "tone/brand": { "pressed": { "bg": "{accent}", "fg": "{accent-foreground}" }, "pressedHover": { "bg": "{accent}/80" } }
  },
  "disabled": { "bg": "{disabled}", "fg": "{disabled-foreground}", "border": "{disabled-border}", "$ref": "shared.disabledInteractive" },
  "states": ["rest", "hover", "focus", "pressed", "disabled", "invalid"],
  "nativeNotes": {
    "pressed": "aria-pressed. tone=neutral → muted-strong(아이콘색 유지, Figma Flow). tone=brand → accent. iOS isOn 바인딩, Compose Toggle selected.",
    "hover": "웹 전용(+data-hovered). 미선택은 muted. 선택(neutral) hover는 muted-strong 유지(호버가 선택보다 옅어지지 않게). 모바일 pressed와 구분.",
    "iconPadding": "has-data-[icon] :has() 로 아이콘 유무별 패딩. 플랫폼은 명시 로직으로."
  }
}

{
  "$schema": "./README.md",
  "name": "Button",
  "slot": "button",
  "$description": "OS-중립 Button 정본. 값 출처: src/components/ui/button.tsx(cva) + component-size-tokens.ts. 토큰 참조 {x}는 semantic.json, {space.x}는 primitives.json.",
  "role": "button",

  "axes": {
    "variant": {
      "$description": "표현 방식",
      "values": ["default", "secondary", "outline", "ghost", "link"]
    },
    "tone": {
      "$description": "색 역할",
      "values": ["neutral", "brand", "success", "warning", "destructive"]
    },
    "size": {
      "$description": "높이 기준 텍스트 5단계 + 아이콘전용 5단계",
      "values": ["xs", "sm", "default", "xl", "2xl", "icon-xs", "icon-sm", "icon", "icon-xl", "icon-2xl"]
    },
    "shape": {
      "$description": "square=rounded-md, circle=rounded-full. button-group 내부에선 둘 다 rounded-none",
      "values": ["square", "circle"]
    }
  },

  "defaults": { "variant": "default", "tone": "neutral", "size": "default", "shape": "square" },

  "deprecatedAliases": [
    { "from": { "variant": "primary" }, "to": { "variant": "default", "tone": "brand" }, "$note": "명시 tone/status 의미색이 있으면 그 색 유지" },
    { "from": { "status": "default" }, "to": { "tone": "neutral" } },
    { "from": { "status": "success|warning|destructive" }, "to": { "tone": "(동일)" } }
  ],

  "sizeSpec": {
    "$note": "height=px 원시값. padX/gap: 스케일 토큰이면 {space.x} 참조, 컨트롤 하프스텝(10px=px-2.5, 6px=gap-1.5)은 스케일에 없으므로 px 원시값으로 둔다 — 없는 토큰을 지어내지 않는다(ghost ref 금지). iconGlyph=Icon size prop(icon-tokens).",
    "xs":       { "height": 24, "minW": 24, "padX": "{space.2}", "gap": "{space.1}",  "fontSize": 12, "iconGlyph": "md" },
    "sm":       { "height": 32, "minW": 32, "padX": 10,          "gap": "{space.1}",  "fontSize": 12.8, "iconGlyph": "md", "$note": "padX px-2.5=10px · text-[0.8rem]=12.8px" },
    "default":  { "height": 36, "minW": 36, "padX": 10,          "gap": 6,            "fontSize": 14, "iconGlyph": "md", "$note": "padX px-2.5=10px · gap gap-1.5=6px" },
    "xl":       { "height": 40, "minW": 40, "padX": "{space.3}", "gap": 6,            "fontSize": 14, "iconGlyph": "lg", "$note": "gap gap-1.5=6px" },
    "2xl":      { "height": 48, "minW": 48, "padX": "{space.3}", "gap": "{space.2}",  "fontSize": 16, "iconGlyph": "xl" },
    "icon-xs":  { "square": 24, "padX": 0, "iconGlyph": "md" },
    "icon-sm":  { "square": 32, "padX": 0, "iconGlyph": "md" },
    "icon":     { "square": 36, "padX": 0, "iconGlyph": "md" },
    "icon-xl":  { "square": 40, "padX": 0, "iconGlyph": "lg" },
    "icon-2xl": { "square": 48, "padX": 0, "iconGlyph": "xl" }
  },

  "shapeSpec": {
    "square": { "radius": "{radius.base}", "$note": "CSS rounded-md; button-group 내부 rounded-none" },
    "circle": { "radius": "9999", "$note": "full; button-group 내부 rounded-none" }
  },

  "base": {
    "$description": "모든 조합 공통",
    "border": "1px transparent",
    "fontWeight": 500,
    "transition": { "duration": "{motion-duration.short}", "easing": "{motion-easing.standard}" },
    "focus": { "border": "{ring}", "ring": "{ring}/50", "ringWidth": 3 },
    "invalid": { "border": "{destructive}", "ring": "{destructive}/20", "ringWidth": 3 }
  },

  "styleSpec": {
    "$note": "(variant/tone) → 상태별 토큰. bg/fg/border는 참조, /NN은 알파%. dark: 접두는 다크모드 override.",

    "default/neutral":     { "rest": { "bg": "{inverse-muted}", "fg": "{inverse-muted-foreground}" }, "hover": { "bg": "{inverse-muted}/80" } },
    "default/brand":       { "rest": { "bg": "{primary}", "fg": "{primary-foreground}" }, "hover": { "bg": "{primary}/80" } },
    "default/success":     { "rest": { "bg": "{success}", "fg": "{success-foreground}" }, "hover": { "bg": "{success}/80" }, "focus": { "border": "{success}/40", "ring": "{success}/20" } },
    "default/warning":     { "rest": { "bg": "{warning}", "fg": "{warning-foreground}" }, "hover": { "bg": "{warning}/80" }, "focus": { "border": "{warning}/40", "ring": "{warning}/20" } },
    "default/destructive": { "rest": { "bg": "{destructive}", "fg": "{destructive-foreground}" }, "hover": { "bg": "{destructive}/80" }, "focus": { "border": "{destructive}/40", "ring": "{destructive}/20" } },

    "secondary/neutral":     { "rest": { "bg": "{secondary}", "fg": "{secondary-foreground}" }, "hover": { "bg": "{accent}", "fg": "{accent-foreground}" }, "expanded": { "bg": "{accent}", "fg": "{accent-foreground}" } },
    "secondary/brand":       { "rest": { "bg": "{primary-container}", "fg": "{primary-container-foreground}" }, "hover": { "bg": "{primary-container}/80" }, "focus": { "border": "{primary}/40", "ring": "{primary}/20" } },
    "secondary/success":     { "rest": { "bg": "{success}/10", "fg": "{success}" }, "hover": { "bg": "{success}/20" }, "focus": { "border": "{success}/40", "ring": "{success}/20" }, "dark": { "rest": { "bg": "{success}/20" }, "hover": { "bg": "{success}/30" } } },
    "secondary/warning":     { "rest": { "bg": "{warning}/15", "fg": "{warning}" }, "hover": { "bg": "{warning}/25" }, "focus": { "border": "{warning}/40", "ring": "{warning}/20" }, "dark": { "rest": { "bg": "{warning}/20" }, "hover": { "bg": "{warning}/30" } } },
    "secondary/destructive": { "rest": { "bg": "{destructive}/10", "fg": "{destructive}" }, "hover": { "bg": "{destructive}/20" }, "focus": { "border": "{destructive}/40", "ring": "{destructive}/20" }, "dark": { "rest": { "bg": "{destructive}/20" }, "hover": { "bg": "{destructive}/30" } } },

    "outline/neutral":     { "rest": { "bg": "transparent", "border": "{border}" }, "hover": { "bg": "{accent}", "fg": "{accent-foreground}" }, "expanded": { "bg": "{accent}", "fg": "{accent-foreground}" }, "dark": { "rest": { "border": "{input}" }, "hover": { "bg": "{accent}" } } },
    "outline/brand":       { "rest": { "bg": "transparent", "border": "{primary}/40", "fg": "{primary}" }, "hover": { "bg": "{primary}/10", "fg": "{primary}" }, "focus": { "border": "{primary}/40", "ring": "{primary}/20" } },
    "outline/success":     { "rest": { "bg": "transparent", "border": "{success}/40", "fg": "{success}" }, "hover": { "bg": "{success}/10", "fg": "{success}" }, "focus": { "border": "{success}/40", "ring": "{success}/20" }, "dark": { "hover": { "bg": "{success}/15" } } },
    "outline/warning":     { "rest": { "bg": "transparent", "border": "{warning}/40", "fg": "{warning}" }, "hover": { "bg": "{warning}/15", "fg": "{warning}" }, "focus": { "border": "{warning}/40", "ring": "{warning}/20" }, "dark": { "hover": { "bg": "{warning}/20" } } },
    "outline/destructive": { "rest": { "bg": "transparent", "border": "{destructive}/40", "fg": "{destructive}" }, "hover": { "bg": "{destructive}/10", "fg": "{destructive}" }, "focus": { "border": "{destructive}/40", "ring": "{destructive}/20" }, "dark": { "hover": { "bg": "{destructive}/15" } } },

    "ghost/neutral":     { "rest": {}, "hover": { "bg": "{accent}", "fg": "{accent-foreground}" }, "expanded": { "bg": "{accent}", "fg": "{accent-foreground}" } },
    "ghost/brand":       { "rest": { "fg": "{primary}" }, "hover": { "bg": "{primary}/10", "fg": "{primary}" }, "focus": { "border": "{primary}/40", "ring": "{primary}/20" } },
    "ghost/success":     { "rest": { "bg": "transparent", "fg": "{success}" }, "hover": { "bg": "{success}/10", "fg": "{success}" }, "focus": { "border": "{success}/40", "ring": "{success}/20" } },
    "ghost/warning":     { "rest": { "bg": "transparent", "fg": "{warning}" }, "hover": { "bg": "{warning}/15", "fg": "{warning}" }, "focus": { "border": "{warning}/40", "ring": "{warning}/20" } },
    "ghost/destructive": { "rest": { "bg": "transparent", "fg": "{destructive}" }, "hover": { "bg": "{destructive}/10", "fg": "{destructive}" }, "focus": { "border": "{destructive}/40", "ring": "{destructive}/20" } },

    "link/neutral":     { "rest": { "bg": "transparent", "fg": "{primary}", "underline": true }, "hover": { "bg": "transparent" } },
    "link/brand":       { "rest": { "bg": "transparent", "fg": "{primary}", "underline": true }, "hover": { "bg": "transparent" } },
    "link/success":     { "rest": { "bg": "transparent", "fg": "{success}", "underline": true }, "hover": { "bg": "transparent" } },
    "link/warning":     { "rest": { "bg": "transparent", "fg": "{warning}", "underline": true }, "hover": { "bg": "transparent" } },
    "link/destructive": { "rest": { "bg": "transparent", "fg": "{destructive}", "underline": true }, "hover": { "bg": "transparent" } }
  },

  "states": ["rest", "hover", "focus", "pressed", "disabled", "invalid", "expanded"],

  "disabled": {
    "$ref": "shared.disabledInteractive",
    "$note": "opacity 저하 + pointer-events none. 정본: src/lib/ui-disabled.ts (uiDisabledInteractive)"
  },

  "nativeNotes": {
    "hover": "웹 전용. iOS: .onHover(macOS만)/pressed 강조로 대체. Compose: Modifier.hoverable 또는 pressed indication. 모바일 터치는 pressed가 hover 역할.",
    "expanded": "aria-expanded 상태(Dropdown 트리거 등). iOS/AOS는 트리거 컴포넌트의 open 상태 바인딩으로 매핑.",
    "focusRing": "웹 focus-visible ring. iOS는 기본 focus 시스템/accessibility, Compose는 Modifier.focusable + indication.",
    "underline(link)": "link variant. iOS Text underline, Compose TextDecoration.Underline.",
    "alpha(/NN)": "CSS color-mix/알파. iOS Color.opacity(NN/100), Compose color.copy(alpha=NN/100f).",
    "buttonGroupRadius": "button-group 내부에선 shape 무시하고 rounded-none — 부모 컨테이너가 모서리 소유. 각 플랫폼 SegmentedControl/ButtonGroup 컨테이너에서 처리.",
    "iconGlyph": "size별 아이콘 글리프 px는 icon-tokens 매핑을 따른다 (xl→lg=18px 주의)."
  }
}

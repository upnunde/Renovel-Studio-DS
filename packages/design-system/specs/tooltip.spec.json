{
  "$schema": "./README.md",
  "name": "Tooltip",
  "slot": "tooltip",
  "$description": "OS-중립 Tooltip 정본. 출처: src/components/ui/tooltip.tsx. inverse 면. open=상시 노출, 미지정=hover. removable=✕.",
  "role": "tooltip",
  "positioning": { "side": "top", "sideOffset": 4, "align": "center", "alignOffset": 0, "delay": 0 },
  "parts": {
    "content": {
      "rest": { "bg": "{inverse}", "fg": "{inverse-foreground}", "radius": "4", "padX": "{space.3}", "padY": 6, "gap": 6, "maxWidth": 320 },
      "animation": { "open": { "duration": "{motion-duration.medium}", "easing": "{motion-easing.emphasized-decelerate}" }, "closed": { "duration": "{motion-duration.short}", "easing": "{motion-easing.emphasized-accelerate}" } }
    },
    "dismiss": { "$note": "removable 시 ✕", "rest": { "fg": "{inverse-foreground}/80" }, "hover": { "bg": "{inverse-foreground}/10", "fg": "{inverse-foreground}" } }
  },
  "states": ["open", "closed"],
  "portal": true,
  "nativeNotes": {
    "surface": "다른 오버레이와 달리 inverse 면(어두운 배경+밝은 텍스트).",
    "arrow": "미사용 — 둥근 박스만 노출 (화살표/꼬리 없음).",
    "removable": "✕ 노출. hover/focus 이탈·바깥 클릭으로 안 닫힘. 닫기는 ✕ 또는 Esc. Playground는 open 켜진 뒤에만 옵션을 노출(종속).",
    "openStates": "웹은 delayed-open(hover)과 open(controlled) 2속성. 네이티브는 단일 open으로.",
    "z": "raw z-50 (FLAG)."
  }
}

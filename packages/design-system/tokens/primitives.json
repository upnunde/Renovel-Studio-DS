  "space": {
    "$type": "dimension",
    "$description": "Material 결 13단계. px 단위 원시값 — CSS는 rem 환산, iOS/AOS는 pt/dp.",
    "px":  { "$value": "1px" },
    "0-5": { "$value": "2px" },
    "1":   { "$value": "4px" },
    "2":   { "$value": "8px" },
    "3":   { "$value": "12px" },
    "4":   { "$value": "16px" },
    "5":   { "$value": "20px" },
    "6":   { "$value": "24px" },
    "8":   { "$value": "32px" },
    "10":  { "$value": "40px" },
    "12":  { "$value": "48px" },
    "16":  { "$value": "64px" },
    "20":  { "$value": "80px" }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "12px", "$description": "--radius 0.75rem" }
  },
  "stroke-width": {
    "$type": "dimension",
    "$value": "0.5px"
  },
  "icon-size": {
    "$type": "dimension",
    "$description": "Lucide stroke 글리프 — 컴포넌트 높이와 정렬. 최소 16px.",
    "md": { "$value": "16px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "20px" },
    "2xl": { "$value": "24px" },
    "3xl": { "$value": "32px" },
    "4xl": { "$value": "40px" }
  },
  "icon-stroke-width": {
    "$type": "number",
    "$value": 1.5
  },
  "motion-duration": {
    "$type": "duration",
    "short":  { "$value": "100ms", "$description": "인터랙티브 상태·내부 이동·퇴장" },
    "medium": { "$value": "200ms", "$description": "등장" },
    "long":   { "$value": "400ms", "$description": "큰 표면 전환" }
  },
  "motion-easing": {
    "$type": "cubicBezier",
    "standard":                { "$value": [0.2, 0, 0, 1],       "$description": "일반 상태 전환" },
    "emphasized-decelerate":   { "$value": [0.05, 0.7, 0.1, 1],  "$description": "등장 (천천히 안착)" },
    "emphasized-accelerate":   { "$value": [0.3, 0, 0.8, 0.15],  "$description": "퇴장 (빠르게 사라짐)" }
  }
}

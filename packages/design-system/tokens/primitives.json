    "$type": "color",
    "10":  { "$value": "rgb(0 0 0 / 2%)" },
    "20":  { "$value": "rgb(0 0 0 / 7%)" },
    "30":  { "$value": "rgb(0 0 0 / 9%)" },
    "40":  { "$value": "rgb(0 0 0 / 13%)" },
    "50":  { "$value": "rgb(0 0 0 / 22%)" },
    "60":  { "$value": "rgb(0 0 0 / 28%)" },
    "70":  { "$value": "rgb(0 0 0 / 42%)" },
    "80":  { "$value": "rgb(0 0 0 / 55%)" },
    "90":  { "$value": "rgb(0 0 0 / 67%)" },
    "100": { "$value": "rgb(0 0 0 / 75%)" },
